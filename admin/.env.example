# Copia este archivo como `.env.local` y completa los valores.
# `.env.local` está en .gitignore: NUNCA lo subas ni lo compartas.

# Llaves de tu aplicación de Clerk (las escribe `clerk init`; también están en https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rutas de inicio de sesión (las escribe `clerk init`)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Identificador (org_...) de la organización del restaurante. Solo sus administradores entran al panel.
# Se obtiene en la pantalla /acceso después de crear la organización.
ADMIN_ORG_ID=

# --- Dónde se guarda la carta ---------------------------------------------------------------
# En tu computador déjalas VACÍAS: el panel edita directamente ../data/menu.json y ../assets/menu.
# En producción (por ejemplo Vercel, donde el disco es de solo lectura) defínelas LAS TRES:
# cada guardado se vuelve un commit en el repositorio y el sitio público se republica solo.
#   GITHUB_TOKEN  -> token "fine-grained" de GitHub, SOLO sobre este repositorio, permiso Contents: Read and write
#   GITHUB_REPO   -> dueño/repositorio, por ejemplo melvinjim/barbecue-garage
#   GITHUB_BRANCH -> rama que publica el sitio (por defecto main)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
